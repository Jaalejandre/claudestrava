# ── macOS / SMB cruft ───────────────────────────────
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# ── Obsidian volatile state (view/layout/cache, per-machine) ──
# match at root and inside any nested project sub-vault
**/.obsidian/workspace*
**/.obsidian/cache
**/.obsidian/graph.json
**/.obsidian/plugins/**/data.json
**/.obsidian/plugins/workspace.json
**/.obsidian/plugins/graph.json
# claudian plugin ships its own nested git repo
**/.obsidian/plugins/claudian

# ── Claudian session state (chat history, churns constantly) ──
.claudian/sessions/
.claudian/cache/

# ── OS / editor ─────────────────────────────────────
*.swp
Thumbs.db
