+// Helper: Apply periodic boundary conditions
+inline void applyPBC(double& dx, double& dy, double& dz, double box_size) {
+    if (dx > box_size * 0.5) dx -= box_size;
+    if (dx < -box_size * 0.5) dx += box_size;
+    if (dy > box_size * 0.5) dy -= box_size;
+    if (dy < -box_size * 0.5) dy += box_size;
+    if (dz > box_size * 0.5) dz -= box_size;
+    if (dz < -box_size * 0.5) dz += box_size;
+}
